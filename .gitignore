!tests/fixtures/*/vault.db
*.db-wal
*.db-shm
*.mcfbak
*.mcfexport
/backup/
*.log

# Build output (.deb packages generated by packaging/build-deb.sh)
build/
dist/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
